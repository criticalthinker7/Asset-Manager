# Local only — copy to .env for `vercel dev`. Production: set in Vercel project settings.
# Never commit .env or service account JSON files.

GOOGLE_SHEET_ID=1AMihb-bA1uRk6tnuXT-5T-LMnJVXAjIE-z9JcFA3_tg
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_WISHLIST_TAB=Wishlist
GOOGLE_NEWSLETTER_TAB=Newsletter

# Optional: Hostinger static deploy uses /cangrants/ — Vercel uses /
# VITE_BASE_PATH=/

# Google Apps Script web app URL (Deploy → Web app → copy URL ending in /exec)
VITE_WISHLIST_ENDPOINT=

# Optional — must match Script property WISHLIST_SECRET in Apps Script
VITE_WISHLIST_SECRET=

# Supabase (get publishable key via Supabase MCP get_publishable_keys after auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production site URL for OAuth redirects (set in Vercel to your live domain)
# VITE_SITE_URL=https://www.canadianartgrants.com

# AI Grant Assistant (server-only — never use VITE_ prefix)
# Get a key at https://console.anthropic.com/ (paid API; new accounts often include starter credits)
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
